[
 {"id":"n1","who":"NARRATOR","voice":"bm_george","speed":1.0,"text":"Midnight. The night of the new moon.","emph":["new","moon"]},
 {"id":"n2","who":"NARRATOR","voice":"bm_george","speed":1.05,"text":"A blackout hits the Belmont Museum.","emph":["blackout"]},
 {"id":"n3","who":"NARRATOR","voice":"bm_george","speed":1.05,"text":"When the lights come back, the Belmont Star is gone. A forty carat diamond.","emph":["gone","diamond"]},
 {"id":"n4","who":"NARRATOR","voice":"bm_george","speed":1.05,"text":"Three people were inside. The cleaner.","emph":["Three","cleaner"]},
 {"id":"s1","who":"CLEANER","voice":"af_nicole","speed":1.0,"text":"I was mopping the east hall. I didn't hear a thing.","emph":["mopping"]},
 {"id":"n5","who":"NARRATOR","voice":"bm_george","speed":1.05,"text":"The curator.","emph":["curator"]},
